# Copy to .env and fill in only what you use. Never commit .env.

# --- Notifications (pick at least one) ---
# install the ntfy app on your phone and subscribe to this topic (pick something unguessable)
NTFY_TOPIC=mason-lab-change-this-to-something-random
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Etsy (https://www.etsy.com/developers) ---
# format: keystring:shared_secret
ETSY_API_KEY=

# --- Twitch (https://dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Kick (https://kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- YouTube upload (Google Cloud project with YouTube Data API v3, OAuth "Desktop" client) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- TikTok Content Posting API (developers.tiktok.com, video.upload scope) ---
TIKTOK_ACCESS_TOKEN=

# --- Printify (printify.com > My account > Connections > API tokens) ---
PRINTIFY_TOKEN=

# --- X / Twitter API v2 (developer.x.com; timeline reads need a paid tier) ---
X_BEARER_TOKEN=
